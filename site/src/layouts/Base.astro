---
import '@fontsource-variable/cinzel';
import '../styles/global.css';
import { sections } from '../catalog';
import { homeHref } from '../lib/routes.mjs';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · Arkesia Codex` : 'Arkesia Codex';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><path d='M16 2 30 16 16 30 2 16Z' fill='%23e2c48d'/><path d='M16 8 24 16 16 24 8 16Z' fill='%230b0d12'/></svg>" />
	</head>
	<body>
		<header class="topbar">
			<a class="brand" href={homeHref}>
				<span class="brand-gem" aria-hidden="true"></span>
				<span>Arkesia Codex</span>
			</a>
			<nav>
				{sections.map((s) => <a href={`${homeHref}#${s.id}`}>{s.title}</a>)}
			</nav>
		</header>
		<slot />
		<footer class="footer">Roster notes · rendered from the local Markdown files</footer>
	</body>
</html>
